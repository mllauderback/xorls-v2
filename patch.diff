From a50ef2e047b00d2a2f3c0833d0af0dea323a87c7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 05:15:01 +0000
Subject: [PATCH] build: raise the initial bundle error budget to 2 MB and load
 the panel eagerly

The properties panel's PrimeNG editors take the initial bundle to about
1.05 MB. The error budget is now 2 MB instead of deferring the panel, so
it is there from the first render.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WnEoHRFXUYrHECpTTT3EVf
---
 angular.json                                                  | 2 +-
 .../selectable-properties.container.component.spec.ts         | 4 +---
 .../container/selectable-properties.container.component.ts    | 4 ----
 3 files changed, 2 insertions(+), 8 deletions(-)

diff --git a/angular.json b/angular.json
index 191d12f..5eb9242 100644
--- a/angular.json
+++ b/angular.json
@@ -42,7 +42,7 @@
                 {
                   "type": "initial",
                   "maximumWarning": "500kB",
-                  "maximumError": "1MB"
+                  "maximumError": "2MB"
                 },
                 {
                   "type": "anyComponentStyle",
diff --git a/src/app/components/selectable-properties/container/selectable-properties.container.component.spec.ts b/src/app/components/selectable-properties/container/selectable-properties.container.component.spec.ts
index ab65440..4908d1a 100644
--- a/src/app/components/selectable-properties/container/selectable-properties.container.component.spec.ts
+++ b/src/app/components/selectable-properties/container/selectable-properties.container.component.spec.ts
@@ -1,5 +1,5 @@
 import type { ComponentFixture } from '@angular/core/testing';
-import { DeferBlockState, TestBed } from '@angular/core/testing';
+import { TestBed } from '@angular/core/testing';
 import { Component, EventEmitter, Input, Output } from '@angular/core';
 import { By } from '@angular/platform-browser';
 import { MockStore, provideMockStore } from '@ngrx/store/testing';
@@ -50,8 +50,6 @@ describe('SelectablePropertiesContainerComponent', () => {
         store = TestBed.inject(MockStore);
         fixture = TestBed.createComponent(SelectablePropertiesContainerComponent);
         fixture.detectChanges();
-        // the presenter loads once the page is idle
-        for (const block of await fixture.getDeferBlocks()) await block.render(DeferBlockState.Complete);
     });

     function presenter() {
diff --git a/src/app/components/selectable-properties/container/selectable-properties.container.component.ts b/src/app/components/selectable-properties/container/selectable-properties.container.component.ts
index b7b47b8..72b050c 100644
--- a/src/app/components/selectable-properties/container/selectable-properties.container.component.ts
+++ b/src/app/components/selectable-properties/container/selectable-properties.container.component.ts
@@ -20,16 +20,12 @@ import type { PropertyListItem } from '../../../models/Property';
         SelectablePropertiesPresenterComponent,
         CommonModule
     ],
-    // The editors (PrimeNG's select, number field and checkbox) load once the page is idle, in a chunk of their own,
-    // so they don't count towards the initial bundle.
     template: `
-    @defer (on idle) {
     <app-selectable-properties-presenter
       [type]="type$ | async"
       [properties]="(properties$ | async) ?? []"
       (propertyChange)="onPropertyChange($event)"
     ></app-selectable-properties-presenter>
-    }
   `,
 })
 export class SelectablePropertiesContainerComponent {
